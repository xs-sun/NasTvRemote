<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#243447" />
            <stroke android:width="2.5dp" android:color="#00E5FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A4A6E" />
            <stroke android:width="2dp" android:color="#40C4FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161E28" />
            <stroke android:width="1dp" android:color="#263238" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
